{
  "name": "clipforge",
  "version": "1.0.0",
  "private": true,
  "description": "ClipForge — turn long-form videos into viral vertical clips with AI captions",
  "workspaces": [
    "frontend",
    "backend",
    "worker"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:worker": "npm run start --workspace worker",
    "build:frontend": "npm run build --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "start:worker": "npm run start --workspace worker"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
