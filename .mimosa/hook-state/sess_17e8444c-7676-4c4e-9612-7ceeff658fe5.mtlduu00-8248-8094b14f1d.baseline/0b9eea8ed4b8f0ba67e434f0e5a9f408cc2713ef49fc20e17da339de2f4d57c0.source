import crypto from "node:crypto";

const WORKER_KEY = process.env.ENCRYPTION_KEY;

/** AES-256-GCM — must match the backend implementation (iv:tag:ciphertext hex). */
export function decryptToken(payload) {
  if (!payload) return null;
  if (!WORKER_KEY || WORKER_KEY.length !== 64) {
    throw new Error("ENCRYPTION_KEY must be a 64-char hex string");
  }
  const [ivHex, tagHex, dataHex] = payload.split(":");
  const decipher = crypto.createDecipheriv(
    "aes-256-gcm",
    Buffer.from(WORKER_KEY, "hex"),
    Buffer.from(ivHex, "hex")
  );
  decipher.setAuthTag(Buffer.from(tagHex, "hex"));
  return Buffer.concat([
    decipher.update(Buffer.from(dataHex, "hex")),
    decipher.final(),
  ]).toString("utf8");
}
