# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Express API backend (Service 2 on Railway)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare R2 public base URL of the storage bucket (r2.dev or custom
# domain) — used for clip thumbnails and feedback screenshots
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
