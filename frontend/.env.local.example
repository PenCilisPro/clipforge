# Firebase web app config (Firebase console → Project settings → General → Your apps → SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=<api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=clipforge-ai-8326b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=clipforge-ai-8326b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=clipforge-ai-8326b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>

# Express API backend (Northflank clipforge-api service URL)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare R2 public base URL of the storage bucket (r2.dev or custom
# domain) — used for clip thumbnails and feedback screenshots
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
